# Copy to .env.local at template root (and apps/web-local if needed)

# --- Database contract (see docs/databases/00-data-contract.md) ---
DATABASE_PROVIDER=postgres
DATABASE_ENV=local
DATABASE_MIGRATE_MODE=prisma
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/superapp
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:5432/superapp

# --- Supabase local profile (uncomment to use) ---
# DATABASE_PROVIDER=supabase
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- MongoDB profile (uncomment to use) ---
# DATABASE_PROVIDER=mongodb
# DATABASE_MIGRATE_MODE=manual
# DATABASE_URL=mongodb://127.0.0.1:27017/superapp

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:8080
API_PORT=8080
WEB_PORT=4000
