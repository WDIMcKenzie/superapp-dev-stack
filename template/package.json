{
  "name": "@superapp/template",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "bash scripts/db/up.sh",
    "db:validate": "bash scripts/db/validate.sh",
    "db:switch": "bash scripts/db/switch-provider.sh",
    "push": "git push",
    "ops:check": "bash scripts/ops/stack-check.sh",
    "ops:run": "bash scripts/ops/stack-run.sh",
    "ops:pull": "bash scripts/ops/git-pull.sh",
    "ops:push": "bash scripts/ops/git-push.sh",
    "ops:hosting": "bash scripts/ops/hosting-setup.sh",
    "ops:deploy:staging": "bash scripts/ops/deploy-staging.sh",
    "ops:deploy:prod": "bash scripts/ops/deploy-prod.sh"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
